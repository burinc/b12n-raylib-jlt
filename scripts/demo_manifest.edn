{:driver  :spawn
 :capture :cgevent-gif

 :examples-cmd "bb demos:examples"

 :out-dir "docs/demos"
 :ledger  "docs/demos/ledger.edn"
 :readme  "docs/demos/README.md"
 :title   "Examples"
 :preamble "Animated GIF previews of every example. Regenerate with `bb record` (requires the internal capture tool; the GIFs here are committed, so you do not need it to browse them)."

 ;; Mirrors the old record_all.clj write-readme! group list, which used
 ;; the bare group name as the heading.
 :groups [{:key "games"
           :title "games"}
          {:key "core"
           :title "core"}
          {:key "shapes"
           :title "shapes"}
          {:key "text"
           :title "text"}
          {:key "3d"
           :title "3d"}
          {:key "generative"
           :title "generative"}
          {:key "textures"
           :title "textures"}]

 :defaults {:duration 6
            :fps 10
            :width 480
            :warmup 10}

 :overrides
 {"asteroids"               {:input [[1.0 :key "up"] [1.5 :key "space"] [2.5 :key "left"] [3.5 :key "space"] [4.5 :key "right"]]}
  "tetris"                  {:input [[1.0 :key "left"] [1.5 :key "left"] [2.0 :key "down"] [2.5 :key "up"] [3.5 :key "right"] [4.5 :key "down"]]}
  "pong"                    {:input [[1.0 :key "w"] [2.0 :key "s"] [3.0 :key "w"] [4.0 :key "s"]]}
  "vampire-survivors"       {:input [[1.0 :key "right"] [2.0 :key "down"] [3.0 :key "left"] [4.0 :key "up"]]}
  "snake"                   {:duration 2
                             :input [[0.3 :key "right"] [0.8 :key "down"]]}
  "breakout"                {:input [[1.0 :click 100 400] [2.0 :click 300 400] [3.0 :click 200 400]]}
  "space-invaders"          {:input [[1.0 :key "left"] [1.5 :key "space"] [2.5 :key "right"] [3.0 :key "space"]]}
  "flappy-bird"             {:input [[0.5 :key "space"] [1.5 :key "space"] [2.5 :key "space"] [3.5 :key "space"] [4.5 :key "space"]]}
  "game-2048"               {:input [[1.0 :key "left"] [2.0 :key "up"] [3.0 :key "right"] [4.0 :key "down"]]}
  "minesweeper"             {:input [[1.0 :click 100 100] [2.0 :click 150 150] [3.0 :click 200 100]]}
  "basic-screen-manager"    {:duration 8
                             :input [[1.5 :key "enter"] [3.5 :key "enter"] [5.5 :key "enter"]]}
  "orthographic-projection" {:duration 8
                             :input [[3.0 :key "space"]]}
  "splines"                 {:duration 8
                             :input [[2.0 :key "space"] [4.0 :key "space"] [6.0 :key "space"]]}

  ;; --- added with the 91-example suite ------------------------------------
  "texture-procedural"      {:input [[1.5 :key "space"] [3.0 :key "space"] [4.5 :key "space"]]}
  "texture-tiling"          {:duration 8
                             :input [[1.0 :key "up"] [1.4 :key "up"] [1.8 :key "up"] [2.2 :key "up"]
                                     [4.0 :key "down"] [4.4 :key "down"] [4.8 :key "down"]]}
  "bunnymark"               {:input [[1.0 :click 400 300] [2.0 :click 250 200]
                                     [3.0 :click 550 250] [4.0 :click 400 150]]}
  "window-flags"            {:duration 8
                             :input [[1.5 :key "one"] [3.0 :key "two"] [4.5 :key "four"] [6.0 :key "one"]]}
  "clipboard-text"          {:input [[1.5 :key "c"] [3.5 :key "v"]]}
  "input-multitouch"        {:input [[1.0 :click 300 200] [2.0 :click 420 260]
                                     [3.0 :click 520 180] [4.0 :click 380 320]]}
  "input-virtual-controls"  {:duration 8
                             :input [[1.0 :click 174 320] [2.0 :click 130 276]
                                     [3.0 :click 86 320] [4.0 :click 680 320]
                                     [5.5 :click 130 364] [6.5 :click 680 320]]}
  "yaw-pitch-roll"          {:duration 8
                             :input [[1.0 :key "a"] [2.0 :key "w"] [3.0 :key "q"]
                                     [4.5 :key "d"] [5.5 :key "e"]]}
  "first-person-maze"       {:duration 8
                             :input [[0.8 :key "w"] [1.6 :key "w"] [2.4 :key "left"]
                                     [3.2 :key "w"] [4.0 :key "w"] [5.0 :key "right"]
                                     [6.0 :key "w"]]}
  "cellular-automata"       {:duration 8
                             :input [[1.5 :key "up"] [3.0 :key "up"] [4.5 :key "right"]
                                     [6.0 :key "space"]]}
  ;; lorenz-attractor, dna-helix, render-texture, window-letterbox,
  ;; monitor-detector and input-gamepad animate or report on their own, so
  ;; they take the defaults with no steering.
  "lorenz-attractor"        {:duration 8}
  "dna-helix"               {:duration 8}}}
