{:paths ["src"]

 ;; raylib is called directly over its C ABI via jolt.ffi (see src/net/b12n/rljlt/core.clj).
 ;; The shared library is the system libraylib — install with `brew install raylib`
 ;; on macOS, or your distro's raylib package on Linux. Chez's dlopen default search
 ;; path doesn't include Homebrew's lib dir, so the absolute path is listed first
 ;; (same reason glimmer-gl lists the OpenGL framework path first).
 :jolt/native [{:name "raylib"
                :darwin ["/opt/homebrew/lib/libraylib.dylib" "libraylib.dylib"]
                :linux  ["libraylib.so.5" "libraylib.so"]}]

 :aliases {:check  {:main-opts ["-m" "net.b12n.rljlt.check"]}   ; headless: compile every example
           :run    {:main-opts ["-m" "net.b12n.rljlt.core"]}    ; basic window (default)
           :input  {:main-opts ["-m" "net.b12n.rljlt.input"]}   ; move a circle with arrow keys
           :bounce {:main-opts ["-m" "net.b12n.rljlt.bounce"]}   ; bouncing ball, SPACE pauses
           :colors {:main-opts ["-m" "net.b12n.rljlt.colors"]}    ; named-color palette grid
           :mouse  {:main-opts ["-m" "net.b12n.rljlt.mouse"]}     ; circle follows the cursor
           :wheel  {:main-opts ["-m" "net.b12n.rljlt.wheel"]}     ; move a box with the mouse wheel
           :shapes {:main-opts ["-m" "net.b12n.rljlt.shapes"]}    ; scalar shape primitives + rlgl triangle
           :gradient {:main-opts ["-m" "net.b12n.rljlt.gradient"]} ; vertical color gradient
           :text   {:main-opts ["-m" "net.b12n.rljlt.text"]}      ; font sizes + MeasureText centering
           :logo   {:main-opts ["-m" "net.b12n.rljlt.logo"]}      ; the raylib logo
           :stars  {:main-opts ["-m" "net.b12n.rljlt.stars"]}      ; twinkling starfield
           :eyes   {:main-opts ["-m" "net.b12n.rljlt.eyes"]}       ; eyes that follow the mouse
           :camera2d {:main-opts ["-m" "net.b12n.rljlt.camera2d"]}  ; 2D camera (struct-by-value)
           :mouse-trail      {:main-opts ["-m" "net.b12n.rljlt.mouse-trail"]}      ; fading cursor trail
           :recursive-tree   {:main-opts ["-m" "net.b12n.rljlt.recursive-tree"]}   ; binary fractal tree
           :math-sine-cosine {:main-opts ["-m" "net.b12n.rljlt.math-sine-cosine"]} ; unit-circle trig
           :bullet-hell      {:main-opts ["-m" "net.b12n.rljlt.bullet-hell"]}      ; rotating bullet spiral
           :triangle-strip   {:main-opts ["-m" "net.b12n.rljlt.triangle-strip"]}   ; rlgl rainbow strip
           :delta-time       {:main-opts ["-m" "net.b12n.rljlt.delta-time"]}       ; per-frame vs delta-time
           :scissor-test     {:main-opts ["-m" "net.b12n.rljlt.scissor-test"]}     ; scissor-clipped grid
           :writing-anim     {:main-opts ["-m" "net.b12n.rljlt.writing-anim"]}     ; self-typing message
           :format-text      {:main-opts ["-m" "net.b12n.rljlt.format-text"]}      ; padded score + timer
           :collision-area   {:main-opts ["-m" "net.b12n.rljlt.collision-area"]}   ; AABB collision highlight
           :dashed-line      {:main-opts ["-m" "net.b12n.rljlt.dashed-line"]}      ; dashed line to the mouse
           :double-pendulum  {:main-opts ["-m" "net.b12n.rljlt.double-pendulum"]}  ; chaotic pendulum + trail
           :kaleidoscope     {:main-opts ["-m" "net.b12n.rljlt.kaleidoscope"]}     ; 6-fold mirrored strokes
           :hilbert-curve    {:main-opts ["-m" "net.b12n.rljlt.hilbert-curve"]}    ; rainbow Hilbert curve
           :math-angle-rotation {:main-opts ["-m" "net.b12n.rljlt.math-angle-rotation"]} ; spokes + spinning line
           :basic-screen-manager {:main-opts ["-m" "net.b12n.rljlt.basic-screen-manager"]} ; LOGO/TITLE/GAMEPLAY/ENDING
           :random-values    {:main-opts ["-m" "net.b12n.rljlt.random-values"]}    ; a random value every 2s
           :words-alignment  {:main-opts ["-m" "net.b12n.rljlt.words-alignment"]}  ; align a word in a box
           :camera-3d        {:main-opts ["-m" "net.b12n.rljlt.camera-3d"]}        ; orbiting 3D camera (Camera3D by value)
           :waving-cubes     {:main-opts ["-m" "net.b12n.rljlt.waving-cubes"]}     ; a grid of cubes rippling in 3D
           :camera-3d-first-person {:main-opts ["-m" "net.b12n.rljlt.camera-3d-first-person"]} ; FP walk with WASD + mouse
           :rlgl-solar-system {:main-opts ["-m" "net.b12n.rljlt.rlgl-solar-system"]} ; Sun/Earth/Moon via rlgl matrix stack
           :box-collisions   {:main-opts ["-m" "net.b12n.rljlt.box-collisions"]}     ; 3D AABB collision highlight
           :asteroids        {:main-opts ["-m" "net.b12n.rljlt.asteroids"]}          ; the classic vector game
           :tetris           {:main-opts ["-m" "net.b12n.rljlt.tetris"]}             ; the block-stacking puzzle
           :pong             {:main-opts ["-m" "net.b12n.rljlt.pong"]}               ; two-paddle classic vs CPU
           :tesseract-view   {:main-opts ["-m" "net.b12n.rljlt.tesseract-view"]}     ; rotating 4D hypercube
           :vampire-survivors {:main-opts ["-m" "net.b12n.rljlt.vampire-survivors"]} ; auto-fire survival game
           :wireframe-shapes {:main-opts ["-m" "net.b12n.rljlt.wireframe-shapes"]}   ; 3D wireframe solids (rlgl lines)
           :rotating-cube    {:main-opts ["-m" "net.b12n.rljlt.rotating-cube"]}    ; single cube spinning (rlgl matrix)
           :spinning-cubes   {:main-opts ["-m" "net.b12n.rljlt.spinning-cubes"]}   ; row of cubes spinning in place
           :orthographic-projection {:main-opts ["-m" "net.b12n.rljlt.orthographic-projection"]} ; perspective/ortho toggle
           :point-cloud      {:main-opts ["-m" "net.b12n.rljlt.point-cloud"]}      ; rotating cloud of tiny cubes
           :bouncing-spheres {:main-opts ["-m" "net.b12n.rljlt.bouncing-spheres"]} ; spheres bouncing (rl/sphere!)
           :ball-physics     {:main-opts ["-m" "net.b12n.rljlt.ball-physics"]}     ; 2D balls under gravity
           :lines-bezier     {:main-opts ["-m" "net.b12n.rljlt.lines-bezier"]}     ; cubic Bézier follows the mouse
           :input-box        {:main-opts ["-m" "net.b12n.rljlt.input-box"]}       ; type into a text box (GetCharPressed)
           :snake            {:main-opts ["-m" "net.b12n.rljlt.snake"]}            ; the classic snake
           :breakout         {:main-opts ["-m" "net.b12n.rljlt.breakout"]}         ; paddle + ball + bricks
           :space-invaders   {:main-opts ["-m" "net.b12n.rljlt.space-invaders"]}   ; marching aliens shooter
           :flappy-bird      {:main-opts ["-m" "net.b12n.rljlt.flappy-bird"]}      ; flap through the pipes
           :game-2048        {:main-opts ["-m" "net.b12n.rljlt.game-2048"]}        ; 2048 tile-merge puzzle
           :minesweeper      {:main-opts ["-m" "net.b12n.rljlt.minesweeper"]}}     ; reveal/flag grid (mouse L/R)

 :tasks {run "joltc -M:run"}}
