;; Babashka runner for the net.b12n.raylib-jlt raylib examples.
;;
;;   bb info            grouped cheat-sheet
;;   bb examples        flat list with descriptions
;;   bb <name>          run one example (opens a window), e.g. bb bouncing-ball
;;   bb run <name>      run one example by argument
;;   bb run-all [secs]  demo reel / smoke test: every example, N seconds each
;;   bb check           headless compile-check of every example (no window)
;;   bb lib:check       is the native libraylib installed for this OS/arch?
;;   bb lib:install     install libraylib via the platform package manager
;;
;; ── Quality — lint/format/checks ──
;;   bb lint                          clj-kondo over src (report only)
;;   bb lint:strict                   bb lint, but exit non-zero if any findings
;;   bb lsp:format                    reformat all Clojure files (clojure-lsp)
;;   bb lsp:format-check              check formatting — dry run
;;   bb lsp:clean-ns                  clean + organize ns forms (clojure-lsp)
;;   bb lsp:clean-ns-check            check ns forms — dry run
;;   bb lsp:diagnostics               clojure-lsp diagnostics
;;   bb lsp:check                     all LSP checks (format + clean-ns + diagnostics) — dry run
;;   bb lsp:fix                       auto-fix: format + clean-ns (mutating)
;;   bb check:positional-args         find fns with 3+ positional args (report only)
;;   bb check:positional-args:strict  bb check:positional-args, but exit non-zero if any found
;;
;; ── Git hooks ──
;;   bb hooks:install                 install FAST pre-commit hook (lint + format + clean-ns, ~2s)
;;   bb hooks:install:full            install FULL pre-commit hook (+ bb check, slower)
;;   bb hooks:uninstall               remove the git pre-commit hook
;;
;; ── Dev ──
;;   bb nrepl [port]                  start a jolt nREPL server (default 7888)
;;
;; Each `bb <name>` example task shells out to the example's joltc alias in
;; deps.edn. Formatting is owned by clojure-lsp, not cljfmt: the two disagree
;; on some compact literal tables (e.g. digital_clock.clj's segment map), so
;; only one formatter may run against src — clojure-lsp was chosen so
;; `lsp:clean-ns` (no cljfmt equivalent) and `lsp:format` share one tool.
;; NOTE: task bodies are read by babashka's EDN reader, which does NOT support
;; #"regex", @deref, or #(...) reader macros — use (fn [x] ...) etc.
{:min-bb-version "1.3.0"
 :paths ["scripts"]

 :tasks
 {;; --- shared registry + helpers (pure; safe to eval before every task) -----
  :init
  (do
    (require '[babashka.fs :as fs]
             '[clojure.java.shell :as sh]
             '[clojure.string :as str])

    ;; clj-kondo ships a fast native binary; prefer it when installed and fall
    ;; back to the clojure-CLI route so a bare checkout still lints. Both were
    ;; verified against .clj-kondo/hooks/jolt_ffi.clj, which is what teaches
    ;; clj-kondo to see through ffi/defcfn.
    (def kondo-dep
      "{:deps {clj-kondo/clj-kondo {:mvn/version \"2025.02.20\"}}}")

    (defn kondo-argv
      []
      (if (fs/which "clj-kondo")
        ["clj-kondo"]
        ["clojure" "-Sdeps" kondo-dep "-M" "-m" "clj-kondo.main"]))

    (require '[examples-registry :as reg])
    (def examples reg/examples)
    (def by-name reg/by-name)

    (defn run-example [name]
      (let [row (get by-name name)]
        (if row
          (do (println (str "▶ " name))
              (shell "joltc" (str "-M:" (nth row 1))))
          (do (binding [*out* *err*]
                (println (str "Unknown example: " (pr-str name)))
                (println "Run `bb examples` to see the list."))
              (System/exit 1)))))

    (def print-row reg/print-row)

    ;; --- native-library (libraylib) detection + install ----------------------
    ;; jolt loads the shared libraylib over its C ABI (see deps.edn :jolt/native).
    ;; These helpers report where that library lives — or how to install it — for
    ;; Linux, macOS/Intel (/usr/local) and macOS/Apple-Silicon (/opt/homebrew).
    (defn os-kind []
      (let [n (str/lower-case (or (System/getProperty "os.name") ""))]
        (cond (str/includes? n "mac")   :macos
              (str/includes? n "linux") :linux
              :else                     :other)))

    (defn arch-kind []
      (let [a (str/lower-case (or (System/getProperty "os.arch") ""))]
        (cond (or (= a "aarch64") (str/includes? a "arm")) :arm64
              (or (= a "x86_64") (= a "amd64"))            :x86_64
              :else                                        (keyword a))))

    ;; macOS: Homebrew's prefix differs by CPU — /opt/homebrew (Apple Silicon)
    ;; vs /usr/local (Intel). List the arch's likely prefix first.
    (defn mac-lib-candidates []
      (let [prefixes (if (= :x86_64 (arch-kind))
                       ["/usr/local" "/opt/homebrew"]
                       ["/opt/homebrew" "/usr/local"])]
        (mapv (fn [p] (str p "/lib/libraylib.dylib")) prefixes)))

    (defn linux-lib-dirs []
      (distinct
       (concat
        (remove str/blank?
                (str/split (or (System/getenv "LD_LIBRARY_PATH") "")
                           (re-pattern ":")))
        ["/usr/lib" "/usr/lib64" "/usr/local/lib"
         "/usr/lib/x86_64-linux-gnu" "/usr/lib/aarch64-linux-gnu"])))

    ;; libraylib entries known to the Linux dynamic-linker cache ([] elsewhere).
    (defn ldconfig-hits []
      (try
        (let [bin (or (some-> (fs/which "ldconfig") str)
                      (first (filter fs/exists? ["/sbin/ldconfig" "/usr/sbin/ldconfig"])))]
          (if bin
            (->> (or (:out (sh/sh (str bin) "-p")) "")
                 str/split-lines
                 (filter (fn [l] (str/includes? l "raylib")))
                 (mapv str/trim))
            []))
        (catch Exception _ [])))

    ;; Return {:found <path-or-nil> :checked [paths] :ldconfig [lines]}.
    (defn find-raylib []
      (case (os-kind)
        :macos (let [cands (mac-lib-candidates)]
                 {:found    (first (filter fs/exists? cands))
                  :checked  cands
                  :ldconfig []})
        :linux (let [dirs (linux-lib-dirs)
                     hits (mapcat (fn [d]
                                    (when (fs/exists? d)
                                      (map str (fs/glob d "libraylib.so*"))))
                                  dirs)
                     ld   (ldconfig-hits)]
                 {:found    (or (first hits)
                                (some (fn [l]
                                        (let [i (str/index-of l "=> ")]
                                          (when i (str/trim (subs l (+ i 3))))))
                                      ld))
                  :checked  (vec dirs)
                  :ldconfig ld})
        {:found nil :checked [] :ldconfig []}))

    ;; Does this path name a libraylib artifact (file) or hold one (dir)?
    (defn lib-present? [p]
      (cond
        (not (fs/exists? p)) false
        (fs/directory? p)    (boolean (seq (fs/glob p "libraylib.{so,dylib}*")))
        :else                true))

    ;; Platform install command, or :manual instructions when none applies.
    (defn installer-plan []
      (case (os-kind)
        :macos (if (fs/which "brew")
                 {:cmd  ["brew" "install" "raylib"]
                  :note "Homebrew installs into /opt/homebrew (Apple Silicon) or /usr/local (Intel) automatically."}
                 {:manual "Install Homebrew from https://brew.sh, then run: brew install raylib"})
        :linux (cond
                 (fs/which "pacman")  {:cmd ["sudo" "pacman" "-S" "--needed" "raylib"]}
                 (fs/which "apt-get") {:cmd ["sudo" "apt-get" "install" "-y" "libraylib-dev"]}
                 (fs/which "dnf")     {:cmd ["sudo" "dnf" "install" "-y" "raylib" "raylib-devel"]}
                 (fs/which "zypper")  {:cmd ["sudo" "zypper" "install" "-y" "raylib-devel"]}
                 (fs/which "apk")     {:cmd ["sudo" "apk" "add" "raylib" "raylib-dev"]}
                 :else {:manual "No supported package manager found. Build from source: https://github.com/raysan5/raylib/wiki/Working-on-GNU-Linux"})
        {:manual "Unsupported OS. See https://github.com/raysan5/raylib for build instructions."})))

  ;; --- one task per example (so `bb <name>` runs it) ------------------------
  basic-window      {:doc "▶ the minimal raylib window + text"             :task (run-example "basic-window")}
  input-keys        {:doc "▶ steer a ball with the arrow keys"            :task (run-example "input-keys")}
  input-mouse       {:doc "▶ a ball follows the mouse; click to recolor"  :task (run-example "input-mouse")}
  input-mouse-wheel {:doc "▶ scroll a box with the mouse wheel"           :task (run-example "input-mouse-wheel")}
  camera-2d         {:doc "▶ a 2D camera over a skyline (struct-by-value)" :task (run-example "camera-2d")}
  bouncing-ball     {:doc "▶ a ball bouncing around the window"           :task (run-example "bouncing-ball")}
  basic-shapes      {:doc "▶ shape primitives + an rlgl triangle"         :task (run-example "basic-shapes")}
  colors-palette    {:doc "▶ every named raylib color in a grid"          :task (run-example "colors-palette")}
  gradient          {:doc "▶ a vertical two-color gradient"               :task (run-example "gradient")}
  following-eyes    {:doc "▶ two eyes track the mouse"                     :task (run-example "following-eyes")}
  starfield         {:doc "▶ a twinkling starfield"                        :task (run-example "starfield")}
  logo-raylib       {:doc "▶ the raylib logo from rectangles + text"      :task (run-example "logo-raylib")}
  font-sizes        {:doc "▶ font sizes + MeasureText centering"          :task (run-example "font-sizes")}
  delta-time        {:doc "▶ per-frame vs delta-time movement"            :task (run-example "delta-time")}
  scissor-test      {:doc "▶ a scissor rectangle clips a grid"            :task (run-example "scissor-test")}
  mouse-trail       {:doc "▶ a fading trail follows the cursor"           :task (run-example "mouse-trail")}
  recursive-tree    {:doc "▶ a binary fractal tree"                       :task (run-example "recursive-tree")}
  math-sine-cosine  {:doc "▶ a live unit-circle trig visualization"       :task (run-example "math-sine-cosine")}
  bullet-hell       {:doc "▶ a rotating bullet spiral"                    :task (run-example "bullet-hell")}
  triangle-strip    {:doc "▶ a rainbow strip via rlgl immediate mode"     :task (run-example "triangle-strip")}
  writing-anim      {:doc "▶ a message types itself out"                  :task (run-example "writing-anim")}
  format-text       {:doc "▶ padded score + MM:SS timer readouts"         :task (run-example "format-text")}
  collision-area    {:doc "▶ AABB collision between two boxes"            :task (run-example "collision-area")}
  dashed-line       {:doc "▶ a dashed line follows the mouse"             :task (run-example "dashed-line")}
  double-pendulum   {:doc "▶ chaotic double-pendulum motion + trail"      :task (run-example "double-pendulum")}
  kaleidoscope      {:doc "▶ strokes mirrored with 6-fold symmetry"       :task (run-example "kaleidoscope")}
  hilbert-curve     {:doc "▶ a rainbow Hilbert space-filling curve"       :task (run-example "hilbert-curve")}
  math-angle-rotation {:doc "▶ fixed spokes + a spinning line"            :task (run-example "math-angle-rotation")}
  basic-screen-manager {:doc "▶ a LOGO/TITLE/GAMEPLAY/ENDING flow"        :task (run-example "basic-screen-manager")}
  random-values     {:doc "▶ a new random value every two seconds"        :task (run-example "random-values")}
  words-alignment   {:doc "▶ align a word inside a box (MeasureText)"     :task (run-example "words-alignment")}
  camera-3d         {:doc "▶ an orbiting 3D camera (Camera3D by value)"    :task (run-example "camera-3d")}
  waving-cubes      {:doc "▶ an NxN grid of cubes rippling in 3D"          :task (run-example "waving-cubes")}
  camera-3d-first-person {:doc "▶ walk a yard of columns in first person"  :task (run-example "camera-3d-first-person")}
  tesseract-view    {:doc "▶ a rotating 4D hypercube projected to 2D"       :task (run-example "tesseract-view")}
  wireframe-shapes  {:doc "▶ pyramid/octahedron/torus/helix in 3D lines"    :task (run-example "wireframe-shapes")}
  rlgl-solar-system {:doc "▶ Sun/Earth/Moon via the rlgl matrix stack"      :task (run-example "rlgl-solar-system")}
  box-collisions    {:doc "▶ a player cube colliding with 3D boxes"         :task (run-example "box-collisions")}
  asteroids         {:doc "▶ the classic vector shooter (rotate/thrust/fire)" :task (run-example "asteroids")}
  tetris            {:doc "▶ the block-stacking puzzle (move/rotate/drop)"  :task (run-example "tetris")}
  pong              {:doc "▶ two-paddle classic, you (W/S) vs a CPU"        :task (run-example "pong")}
  vampire-survivors {:doc "▶ auto-fire survival: move, waves chase you"      :task (run-example "vampire-survivors")}
  rotating-cube     {:doc "▶ a single cube spinning via the rlgl matrix stack" :task (run-example "rotating-cube")}
  spinning-cubes    {:doc "▶ a row of cubes each spinning with a phase offset" :task (run-example "spinning-cubes")}
  orthographic-projection {:doc "▶ perspective vs orthographic (SPACE toggles)" :task (run-example "orthographic-projection")}
  point-cloud       {:doc "▶ ~1500 points as tiny rlgl cubes, rotating"        :task (run-example "point-cloud")}
  bouncing-spheres  {:doc "▶ spheres bouncing in a 3D box (rl/sphere!)"        :task (run-example "bouncing-spheres")}
  ball-physics      {:doc "▶ 2D balls under gravity, SPACE respawns"           :task (run-example "ball-physics")}
  lines-bezier      {:doc "▶ a cubic Bézier that follows the mouse"            :task (run-example "lines-bezier")}
  input-box         {:doc "▶ type into a text box (GetCharPressed)"            :task (run-example "input-box")}
  snake             {:doc "▶ the classic snake (arrow keys, grow, don't crash)" :task (run-example "snake")}
  breakout          {:doc "▶ paddle + ball + brick grid (mouse paddle)"        :task (run-example "breakout")}
  space-invaders    {:doc "▶ marching aliens (arrows + SPACE to shoot)"        :task (run-example "space-invaders")}
  flappy-bird       {:doc "▶ flap through the pipe gaps (SPACE)"               :task (run-example "flappy-bird")}
  game-2048         {:doc "▶ 2048: 4x4 tile-merge puzzle (arrow keys)"         :task (run-example "game-2048")}
  minesweeper       {:doc "▶ reveal/flag grid (mouse L reveal, R flag)"        :task (run-example "minesweeper")}
  game-of-life      {:doc "▶ Conway's Game of Life (SPACE reseeds)"            :task (run-example "game-of-life")}
  boids             {:doc "▶ flocking birds (separation/alignment/cohesion)"  :task (run-example "boids")}
  fireworks         {:doc "▶ rockets + fading particle bursts"                :task (run-example "fireworks")}
  fourier-epicycles {:doc "▶ rotating circles trace a square wave"            :task (run-example "fourier-epicycles")}
  spirograph        {:doc "▶ animated hypotrochoid roulette curves"           :task (run-example "spirograph")}
  l-system          {:doc "▶ an L-system fractal plant (grows + regrows)"     :task (run-example "l-system")}
  flow-field        {:doc "▶ particles steered by a flow field (trails)"      :task (run-example "flow-field")}
  color-wheel       {:doc "▶ an HSV color wheel (rlgl triangle fan)"          :task (run-example "color-wheel")}
  pie-chart         {:doc "▶ labelled pie slices via rl/sector!"               :task (run-example "pie-chart")}
  splines           {:doc "▶ Catmull-Rom / Bezier / B-spline (SPACE cycles)"    :task (run-example "splines")}
  vector-angle      {:doc "▶ the angle between two vectors (arc + readout)"     :task (run-example "vector-angle")}
  easings           {:doc "▶ a grid of balls on different easing curves"        :task (run-example "easings")}
  penrose-tiling    {:doc "▶ a P3 Penrose rhombus tiling (deflation)"           :task (run-example "penrose-tiling")}
  analog-clock      {:doc "▶ a live analog clock (libc local time)"             :task (run-example "analog-clock")}
  digital-clock     {:doc "▶ a seven-segment HH:MM:SS clock (libc time)"        :task (run-example "digital-clock")}
  ring-drawing      {:doc "▶ an animated annulus via rl/ring!"                   :task (run-example "ring-drawing")}
  rounded-rectangle {:doc "▶ rounded rects via sector! corners"                 :task (run-example "rounded-rectangle")}
  rectangle-scaling {:doc "▶ drag the corner handle to resize a rect"           :task (run-example "rectangle-scaling")}
  lines-drawing     {:doc "▶ a rotating fan of thick lines (line-ex!)"           :task (run-example "lines-drawing")}

  ;; --- meta tasks -----------------------------------------------------------
  run
  {:doc "Run an example by name: bb run <name>"
   :override-builtin true
   :task (run-example (first *command-line-args*))}

  run-all
  {:doc "Demo reel / smoke test: every example N seconds each (default 15): bb run-all [secs]"
   :task (let [secs (or (some-> (first *command-line-args*) parse-long) 15)
               ms   (str (* secs 1000))]
           (println (str "Running " (count examples) " examples, " secs "s each…"))
           (doseq [row examples]
             (println (str "▶ " (nth row 0)))
             (shell {:extra-env {"RAYLIB_APP_AUTO_QUIT_MS" ms} :continue true}
                    "joltc" (str "-M:" (nth row 1)))))}

  record
  {:doc "Batch-record a demo GIF for every example: bb record [--only a,b] [--force] [--dry-run]"
   :task (if-not (fs/which "screen-grab")
           (binding [*out* *err*]
             (println "bb record needs the `screen-grab` capture CLI on your PATH.")
             (println "That tool is internal and not publicly released yet, so this")
             (println "task is maintainer-only. You do not need it to view the demos:")
             (println "every GIF is committed under docs/demos/ — see docs/demos/README.md.")
             (System/exit 1))
           (let [{:keys [exit]} (apply shell {:continue true}
                                       "screen-grab" "record"
                                       "--manifest" "scripts/demo_manifest.edn"
                                       *command-line-args*)]
             (System/exit exit)))}

  demos:examples
  {:doc "Print the demo item list as EDN for screen-grab"
   :task
   (prn (vec (for [row examples]
               {:id (nth row 0)
                :group (nth row 2)
                :desc (nth row 3)
                :src (reg/src-path (nth row 1))
                :run (str "joltc -M:" (nth row 1))})))}

  docs-sync
  {:doc "Rebuild and republish the docs after a docs/guide or README change. Four steps: rebuild the site via ~/dev/b12n-docs, commit+push the generated output to ~/dev/b12n-raylib-jlt.github.io, mirror+push docs/guide/*.md to ~/dev/b12n-wikis/b12n-raylib-jlt/, then sync the built site to S3 and invalidate CloudFront (https://raylib-jlt.b12n.app). Each git target is fetched and checked for concurrent remote changes first — this never auto-rebases or force-pushes; it prints guidance and stops if behind. Steps whose target is unchanged, or whose tooling is unavailable, skip with an explanation rather than failing. --no-push publishes nothing outward: it commits locally and skips both pushes AND the deploy. Maintainer task — needs the sibling repos and AWS credentials. bb docs-sync [--no-push]"
   ;; Modelled on b12n-cgevent's task of the same name. A pure bb.edn task
   ;; rather than a Clojure entry point, because it orchestrates two sibling
   ;; repos plus an external build tool (b12n-docs) — none of which is this
   ;; project's own logic.
   ;;
   ;; The site's CNAME (raylib-jlt.b12n.net) is written by the b12n-docs
   ;; engine from :cname in projects/b12n-raylib-jlt.edn, NOT committed by
   ;; hand here: `bb site:build` deletes the whole output dir before writing,
   ;; so a hand-placed CNAME would survive exactly one build and then vanish,
   ;; silently taking the custom domain down.
   :task
   (let [push?     (not (some (fn [a] (= a "--no-push")) *command-line-args*))
         home      (System/getProperty "user.home")
         proj-dir  (System/getProperty "user.dir")
         docs-repo (str home "/dev/b12n-docs")
         site-repo (str home "/dev/b12n-raylib-jlt.github.io")
         wiki-repo (str home "/dev/b12n-wikis")
         wiki-dir  (str wiki-repo "/b12n-raylib-jlt")
         guide-dir (str proj-dir "/docs/guide")
         bucket    "b12n-site-raylib-jlt"
         site-host "raylib-jlt.b12n.app"
         hdr       (fn [label] (println (str "\n── " label " ──")))
         dirty?    (fn [dir path]
                     (let [res (shell {:dir dir :out :string} "git" "status" "--short" "--" path)]
                       (not (str/blank? (:out res)))))
         ;; Returns a keyword, never System/exit's mid-flight, so one repo's
         ;; hiccup doesn't block the other (independent) step. `git add` and
         ;; `git commit` are both scoped to `path` explicitly — never -A/. —
         ;; because b12n-wikis is SHARED across many projects and a stray
         ;; staged file from a concurrent session must not ride along.
         sync!     (fn [opts]
                     (let [label (:label opts) dir (:dir opts)
                           path (:path opts) msg (:msg opts)]
                       (hdr label)
                       (if-not (dirty? dir path)
                         (do (println "  up to date, nothing to commit") :skipped)
                         (do
                           (shell {:dir dir} "git" "add" "--" path)
                           (shell {:dir dir} "git" "commit" "-m" msg "--" path)
                           (if-not push?
                             (do (println "  committed locally (--no-push)") :ok)
                             (do
                               (shell {:dir dir :continue true} "git" "fetch" "origin")
                               (let [res (shell {:dir dir :out :string} "git" "status" "--short" "--branch")]
                                 (if (str/includes? (:out res) "behind")
                                   (do (println (str "  BEHIND origin — resolve manually (cd " dir " && git pull --rebase), not auto-pushing"))
                                       :behind)
                                   (let [pr (shell {:dir dir :continue true} "git" "push" "origin" "main")]
                                     (if (zero? (:exit pr))
                                       (do (println "  pushed") :ok)
                                       (do (println "  PUSH FAILED") :push-failed)))))))))))
         ;; Publishes the BUILT site (not the git repo) to the S3 origin
         ;; behind CloudFront, then invalidates the edge cache. Provisioned
         ;; by ~/dev/b12n-infra's static-site module
         ;; (resources/static-site/raylib-jlt.edn).
         ;;
         ;; Degrades instead of exploding: skips with an explanation when the
         ;; aws CLI is absent or the bucket doesn't exist yet (i.e. before
         ;; anyone has run `bb render tofu:apply -- static-site raylib-jlt`),
         ;; so docs-sync stays useful for people who only build and mirror.
         ;;
         ;; The distribution id is looked up by alias rather than hardcoded:
         ;; tofu owns it, it changes if the distribution is ever replaced,
         ;; and a stale hardcoded id would invalidate someone else's site.
         deploy!   (fn []
                     (hdr "4/4 Deploy to S3 + CloudFront")
                     (cond
                       (not push?)
                       (do (println "  skipped (--no-push publishes nothing outward)") :skipped)

                       (not (fs/which "aws"))
                       (do (println "  aws CLI not on PATH \u2014 skipping deploy") :skipped)

                       :else
                       (let [probe (shell {:continue true :out :string :err :string}
                                          "aws" "s3api" "head-bucket"
                                          "--bucket" bucket "--profile" "b12n")]
                         (if-not (zero? (:exit probe))
                           (do (println (str "  s3://" bucket " not reachable. Most likely the infrastructure"))
                               (println "  hasn't been applied yet; it could also be AWS credentials or")
                               (println "  network. head-bucket said:")
                               (println (str "    " (str/trim (str (:err probe) (:out probe)))))
                               (println "  If it's the first case, run this once in ~/dev/b12n-infra:")
                               (println "    bb render lock tofu:init tofu:plan tofu:apply -- static-site raylib-jlt")
                               :skipped)
                           (let [sync-res (shell {:continue true}
                                                 "aws" "s3" "sync" (str site-repo "/docs/")
                                                 (str "s3://" bucket "/")
                                                 "--profile" "b12n" "--delete")]
                             (if-not (zero? (:exit sync-res))
                               (do (println "  S3 SYNC FAILED") :sync-failed)
                               (let [q (str "DistributionList.Items[?contains(Aliases.Items, `" site-host "`)].Id | [0]")
                                     dist (shell {:continue true :out :string}
                                                 "aws" "cloudfront" "list-distributions"
                                                 "--profile" "b12n" "--query" q "--output" "text")
                                     id (str/trim (or (:out dist) ""))]
                                 (if (or (str/blank? id) (= id "None"))
                                   (do (println (str "  synced, but no CloudFront distribution found for " site-host))
                                       (println "  (cache not invalidated \u2014 edge may serve stale files for a while)")
                                       :no-distribution)
                                   (let [inv (shell {:continue true}
                                                    "aws" "cloudfront" "create-invalidation"
                                                    "--profile" "b12n" "--distribution-id" id
                                                    "--paths" "/*")]
                                     (if (zero? (:exit inv))
                                       (do (println (str "  synced + invalidated (" id ") \u2014 https://" site-host)) :ok)
                                       (do (println "  synced, but INVALIDATION FAILED") :invalidation-failed)))))))))))]
     (hdr "1/4 Rebuild site")
     (let [res       (shell {:dir docs-repo :continue true} "bb" "site:build" "b12n-raylib-jlt")
           build-ok? (zero? (:exit res))]
       (when-not build-ok? (println "  bb site:build FAILED"))
       (let [site-result (if build-ok?
                           (sync! {:label "2/4 b12n-raylib-jlt.github.io" :dir site-repo :path "docs"
                                   :msg "chore: rebuild docs (bb docs-sync)"})
                           :build-failed)]
         (fs/create-dirs wiki-dir)
         (doseq [f (fs/glob guide-dir "*.md")]
           (fs/copy f (str wiki-dir "/" (fs/file-name f)) {:replace-existing true}))
         (let [wiki-result (sync! {:label "3/4 b12n-wikis" :dir wiki-repo :path "b12n-raylib-jlt"
                                   :msg "b12n-raylib-jlt: mirror docs/guide (bb docs-sync)"})]
           (let [deploy-result (deploy!)]
             (hdr "Summary")
             (println (str "  site:   " site-result))
             (println (str "  wiki:   " wiki-result))
             (println (str "  deploy: " deploy-result))
             (when (some (fn [r] (contains? #{:behind :push-failed :build-failed
                                              :sync-failed :invalidation-failed} r))
                         [site-result wiki-result deploy-result])
               (System/exit 1)))))))}

  examples
  {:doc "List every runnable example with its description"
   :task (doseq [row examples] (print-row row))}

  info
  {:doc "Grouped cheat-sheet of all examples"
   :task (do
           (doseq [g ["games" "core" "shapes" "text" "3d" "generative"]]
             (let [rows (filterv (fn [row] (= g (nth row 2))) examples)]
               (println (str "\n=== " g " (" (count rows) ") ==="))
               (doseq [row rows] (print-row row))))
           (println)
           (println "Run any example with `bb <name>` · list: `bb examples` · all tasks: `bb tasks`")
           (println "Demo reel / smoke test: `bb run-all [secs]` · headless check: `bb check`")
           (println "Lint: `bb lint` (clj-kondo) · Format: `bb lsp:format` · `bb lsp:fix` (format + clean-ns)")
           (println "Native library: `bb lib:check` (is libraylib installed?) · `bb lib:install`")
           (println "Git hooks: `bb hooks:install` (fast) · `bb hooks:install:full` · nREPL: `bb nrepl [port]`"))}

  check
  {:doc "Headless compile-check of every example (no window)"
   :task (shell "joltc" "-M:check")}

  ;; --- quality: lint (clj-kondo) --------------------------------------------
  ;; Formatting lives under lsp:format below, not here — see the top-of-file
  ;; note on why clojure-lsp (not cljfmt) owns formatting in this project.
  lint
  {:doc "clj-kondo over src (report only, always exits 0); strict: bb lint:strict"
   :task (let [{:keys [exit]} (apply shell {:continue true} (concat (kondo-argv) ["--lint" "src"]))]
           (println (if (zero? exit) "✓ clj-kondo: no errors or warnings" "✗ clj-kondo: see findings above")))}

  lint:strict
  {:doc "bb lint, but exit non-zero if clj-kondo reports any findings (2=warnings, 3=errors)"
   :task (let [{:keys [exit]} (apply shell {:continue true} (concat (kondo-argv) ["--lint" "src"]))]
           (System/exit exit))}

  ;; --- quality: clojure-lsp (format + clean-ns + diagnostics) ---------------
  lsp:format
  {:doc "Reformat all Clojure files (clojure-lsp)"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "format")]
           (if (zero? exit)
             (println "✓ formatted")
             (do (println "✗ format failed") (System/exit exit))))}

  lsp:format-check
  {:doc "Check formatting — dry run"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "format" "--dry")]
           (if (zero? exit)
             (println "✓ all files formatted")
             (do (println "✗ files need formatting — run bb lsp:format") (System/exit exit))))}

  lsp:clean-ns
  {:doc "Clean + organize ns forms (clojure-lsp)"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "clean-ns")]
           (if (zero? exit)
             (println "✓ namespaces cleaned")
             (do (println "✗ clean-ns failed") (System/exit exit))))}

  lsp:clean-ns-check
  {:doc "Check ns forms — dry run"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")]
           (if (zero? exit)
             (println "✓ all ns forms clean")
             (do (println "✗ ns forms need cleaning — run bb lsp:clean-ns") (System/exit exit))))}

  ;; clojure-lsp's :diagnostics command runs clj-kondo under the hood too, so
  ;; this mostly mirrors `bb lint` plus any LSP-only diagnostics.
  lsp:diagnostics
  {:doc "clojure-lsp diagnostics"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "diagnostics")]
           (if (zero? exit)
             (println "✓ no diagnostics")
             (println "✗ diagnostics found (see above)")))}

  lsp:check
  {:doc "All LSP checks (format + clean-ns + diagnostics) — dry run"
   :task (do (println "-> LSP checks (dry run)")
             (println "-> format --dry")
             (shell {:continue true} "clojure-lsp" "format" "--dry")
             (println "-> clean-ns --dry")
             (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")
             (println "-> diagnostics")
             (shell {:continue true} "clojure-lsp" "diagnostics")
             (println "✓ LSP checks done (see above for any issues)"))}

  lsp:fix
  {:doc "Auto-fix: format + clean-ns (mutating)"
   :task (do (println "-> LSP auto-fix")
             (println "-> format")
             (shell {:continue true} "clojure-lsp" "format")
             (println "-> clean-ns")
             (shell {:continue true} "clojure-lsp" "clean-ns")
             (println "✓ auto-fixes applied — run bb lsp:diagnostics + bb check to confirm"))}

  ;; --- quality: positional-args check ---------------------------------------
  check:positional-args
  {:doc "Find fns with 3+ positional args (prefer a kwargs map; report only)"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj")]
           (System/exit exit))}

  check:positional-args:strict
  {:doc "bb check:positional-args, but exit non-zero if any found"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj" "--strict")]
           (System/exit exit))}

  ;; --- native library (libraylib) ------------------------------------------
  lib:check
  {:doc "Is the native libraylib installed for this OS/arch? (read-only)"
   :task (let [{:keys [found checked ldconfig]} (find-raylib)]
           (println (str "OS: " (name (os-kind)) "  ·  arch: " (name (arch-kind))))
           (println "Looked in:")
           (doseq [p checked]
             (println (str "  " (if (lib-present? p) "✓" "·") " " p)))
           (when (seq ldconfig)
             (println "ldconfig cache:")
             (doseq [l ldconfig] (println (str "    " l))))
           (if found
             (println (str "\n✓ libraylib found: " found))
             (do
               (binding [*out* *err*]
                 (println "\n✗ libraylib NOT found.")
                 (println "  • install the package:  bb lib:install")
                 (println "  • or point the loader at a source build, e.g.:")
                 (println "      Linux:  export LD_LIBRARY_PATH=$HOME/dev/raylib/build/raylib")
                 (println "      macOS:  export DYLD_LIBRARY_PATH=$HOME/dev/raylib/build/raylib"))
               (System/exit 1))))}

  lib:install
  {:doc "Install libraylib via the platform package manager (add --dry-run to preview)"
   :task (let [{:keys [cmd note manual]} (installer-plan)
               dry? (some #{"--dry-run" "-n"} *command-line-args*)]
           (when note (println note))
           (cond
             manual (do (binding [*out* *err*] (println manual))
                        (System/exit 1))
             dry?   (println "Would run:" (str/join " " cmd))
             :else  (do (println "Running:" (str/join " " cmd))
                        (apply shell cmd)
                        (println "\nDone. Verify with: bb lib:check"))))}

  ;; --- git hooks --------------------------------------------------------------
  ;; FAST hook: lint (any finding blocks, matching `bb lint:strict`) + format +
  ;; clean-ns dry-run, ~2s. FULL adds `bb check` (headless compile of every
  ;; example) — the project has no unit-test suite, so that's the closest
  ;; equivalent pre-commit gate.
  hooks:install
  {:doc "Install FAST git pre-commit hook (lint + format + clean-ns, ~2s)"
   :task (let [hook ".git/hooks/pre-commit"]
           (spit hook (str "#!/bin/bash\n"
                           "# net.b12n.raylib-jlt pre-commit (FAST — lint + format + clean-ns dry-run).\n"
                           "# Full (+ headless compile-check): bb hooks:install:full\n"
                           "echo 'pre-commit 1/3: bb lint:strict (clj-kondo)'\n"
                           "bb lint:strict || { echo 'pre-commit: lint findings — see above'; exit 1; }\n"
                           "echo 'pre-commit 2/3: clojure-lsp format --dry'\n"
                           "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/3: clojure-lsp clean-ns --dry'\n"
                           "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                           "exit 0\n"))
           (shell "chmod" "+x" hook)
           (println "✓ fast pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full
  {:doc "Install FULL git pre-commit hook (+ headless compile-check of every example, slower)"
   :task (let [hook ".git/hooks/pre-commit"]
           (spit hook (str "#!/bin/bash\n"
                           "# net.b12n.raylib-jlt pre-commit (FULL). Fast: bb hooks:install\n"
                           "echo 'pre-commit 1/4: bb lint:strict (clj-kondo)'\n"
                           "bb lint:strict || { echo 'pre-commit: lint findings — see above'; exit 1; }\n"
                           "echo 'pre-commit 2/4: clojure-lsp format --dry'\n"
                           "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/4: clojure-lsp clean-ns --dry'\n"
                           "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                           "echo 'pre-commit 4/4: bb check (headless compile-check of every example)'\n"
                           "bb check\n"
                           "exit $?\n"))
           (shell "chmod" "+x" hook)
           (println "✓ full pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall
  {:doc "Remove the git pre-commit hook"
   :task (let [hook ".git/hooks/pre-commit"]
           (if (fs/exists? hook)
             (do (fs/delete hook) (println "✓ pre-commit hook removed"))
             (println ">> no pre-commit hook found")))}

  ;; --- dev & repl ---------------------------------------------------------
  nrepl
  {:doc "Start a jolt nREPL server for interactive dev: bb nrepl [port] (default 7888)"
   :task (shell "joltc" "nrepl-server" (or (first *command-line-args*) "7888"))}}}
